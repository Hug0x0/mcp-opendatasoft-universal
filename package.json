{
  "name": "mcp-opendatasoft-universal",
  "version": "0.1.0",
  "description": "Universal MCP server for querying any OpenDataSoft Explore v2.1 portal.",
  "type": "module",
  "bin": {
    "mcp-opendatasoft-universal": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "open-data",
    "france",
    "opendatasoft",
    "ods",
    "catalog",
    "open-data"
  ],
  "author": "Hug0x0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hug0x0/mcp-opendatasoft-universal.git"
  },
  "bugs": {
    "url": "https://github.com/Hug0x0/mcp-opendatasoft-universal/issues"
  },
  "homepage": "https://github.com/Hug0x0/mcp-opendatasoft-universal#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
